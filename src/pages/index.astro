---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { Image } from "astro:assets";
import profpic from "@/assets/images/profpic.jpg";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="flex flex-col-reverse sm:flex-row sm:items-start sm:justify-between gap-8">
        <div class="flex-1">
          <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
            Hi, I'm Radhit
          </h1>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="inline-block"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={20}
              height={20}
              class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
            />
            <span class="sr-only">RSS Feed</span>
          </a>

          <p class="text-base sm:text-lg leading-relaxed">
            I am an <strong>Informatics Engineering</strong> student at <a href="https://www.its.ac.id/" class="hover:text-accent underline decoration-dashed underline-offset-4"><strong>Institut Teknologi Sepuluh Nopember (ITS)</strong></a>. My academic journey is fueled by a deep fascination with the intersection of high-level intelligence and low-level efficiency.
          </p>
          <p class="mt-4 text-base sm:text-lg leading-relaxed">
            My primary passions lie in <strong>Deep Learning</strong> and <strong>Systems Programming</strong>. I enjoy exploring the architecture of neural networks and understanding how software interacts with hardware at the most fundamental levels.
          </p>
          {
            socials.length > 0 && (
              <div class="mt-4 flex max-sm:flex-col sm:items-center">
                <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                  {t.home.socialLinks}:
                </div>
                <Socials />
              </div>
            )
          }
        </div>
        
        {/* Profile Image Column */}
        <div class="flex flex-col items-center sm:items-end mt-4 sm:mt-8 shrink-0">
          <Image
            src={profpic}
            alt="Radhit Akriandra"
            class="w-48 sm:w-60 h-auto rounded-xl border border-border shadow-sm"
          />
          <div class="mt-2 text-xs text-muted-foreground text-center sm:text-right">
            <p>Surabaya, West Java</p>
          </div>
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section id="recent-posts" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">
        {t.home.recentPosts}
      </h2>
      {
        recentPosts.length > 0 ? (
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        ) : (
          <p class="mt-4 italic text-muted-foreground">{t.home.noPosts}</p>
        )
      }
    </section>

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
